{
  "name": "@usovia/desktop",
  "version": "1.3.0",
  "private": true,
  "description": "Gobierno corporativo de IA con participaci\u00f3n autorizada",
  "author": "Usovia",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "package": "npm run build:browser-helper && electron-builder --mac zip dmg --arm64",
    "build:browser-helper": "node ../scripts/build-browser-helper.mjs",
    "package:win": "npm run build:windows-browser-helper && electron-builder --win nsis --x64 --publish never",
    "bundle:win": "pwsh -File ../scripts/bundle-runtime-windows.ps1",
    "build:windows-browser-helper": "pwsh -File ../scripts/build-windows-browser-helper.ps1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.usovia.desktop",
    "productName": "Usovia",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "*.mjs",
      "*.cjs",
      "ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../shared",
        "to": "shared",
        "filter": [
          "analysis.mjs",
          "providers.mjs",
          "cli-entry.mjs"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "ui/app-icon.png",
      "target": [
        "zip",
        "dmg"
      ],
      "extraResources": [
        {
          "from": "runtime",
          "to": "ollama",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native/bin",
          "to": "browser-helper",
          "filter": [
            "usovia-browser-helper"
          ]
        }
      ]
    },
    "artifactName": "Usovia-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "ui/app-icon.png",
      "extraResources": [
        {
          "from": "runtime-windows",
          "to": "ollama",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native/bin",
          "to": "browser-helper",
          "filter": [
            "usovia-windows-browser-helper.exe"
          ]
        }
      ],
      "artifactName": "Usovia-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Usovia",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "es_ES",
        "en_US"
      ],
      "language": "3082",
      "include": "native/windows-installer.nsh"
    }
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "reflect-metadata": "^0.2.2"
  }
}
