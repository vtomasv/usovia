{
  "name": "usovia-hub",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "desktop:dev": "npm run start --workspace @usovia/desktop",
    "desktop:package": "npm run package --workspace @usovia/desktop",
    "db:init": "node scripts/db-init.mjs",
    "deploy": "vercel --prod",
    "vercel:login": "vercel login",
    "format:check": "prettier --check src",
    "format": "prettier --write src",
    "predeploy": "npm run format:check && npm run check && npm test"
  },
  "workspaces": [
    "desktop"
  ],
  "dependencies": {
    "dotenv": "^17.2.3",
    "hyparquet-writer": "0.16.11",
    "lucide-react": "^0.468.0",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "hyparquet": "1.31.3",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vercel": "63.1.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": "22.x"
  }
}
