# Private worker only; never commit actual credentials.
DATABASE_URL=
TENANT_ID=usovia
# When using the default command from the repository root:
USOVIA_WORKER_ENV_FILE=analytics-worker/.env
USOVIA_MODEL_CACHE=.runtime/semantic-models
# Set 1 only after approved pinned model assets are present in the cache.
USOVIA_MODELS_OFFLINE=0
